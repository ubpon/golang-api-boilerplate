# Copy to .env and adjust. Never commit a filled-in .env.
# Every value below is read from the process environment only.

# ---- Application -----------------------------------------------------------
APP_ENV=development                 # development | production | test
APP_BASE_URL=http://localhost:8080  # used to build verification / reset links
HTTP_ADDR=:8080

# ---- Logging ---------------------------------------------------------------
LOG_LEVEL=info                      # debug | info | warn | error
LOG_FORMAT=text                     # text in development, json in production
LOG_ADD_SOURCE=false

# ---- Database (required) ---------------------------------------------------
DATABASE_URL=postgres://boilerplate:boilerplate@localhost:5432/boilerplate?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_QUERY_TIMEOUT=5s

# ---- Redis (optional; leave empty to use the in-process limiter) ------------
REDIS_URL=

# ---- Tokens (JWT_SECRET is required and must be >= 32 bytes) ---------------
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-bytes-of-entropy
JWT_ISSUER=golang-api-boilerplate
JWT_AUDIENCE=golang-api-boilerplate-clients
ACCESS_TOKEN_TTL=15m
JWT_CLOCK_SKEW=30s        # tolerance for clock drift when validating exp/nbf/iat
REFRESH_TOKEN_TTL=720h
RESET_TOKEN_TTL=15m
VERIFY_TOKEN_TTL=24h
REQUIRE_VERIFIED_EMAIL=false

# ---- Cookies ---------------------------------------------------------------
COOKIE_SECURE=false                 # must be true when APP_ENV=production
COOKIE_DOMAIN=
COOKIE_REFRESH_PATH=/v1/auth        # must cover /v1/auth/refresh and /v1/auth/logout
COOKIE_ACCESS_NAME=access_token
COOKIE_REFRESH_NAME=refresh_token
COOKIE_CSRF_NAME=csrf_token

# ---- CORS ------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-CSRF-Token,X-Request-ID
CORS_EXPOSED_HEADERS=X-Request-ID,Retry-After,X-RateLimit-Limit,X-RateLimit-Remaining,X-RateLimit-Reset
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=10m

# ---- Reverse proxies -------------------------------------------------------
# Leave EMPTY unless the API really sits behind a proxy you control.
# X-Forwarded-For / X-Real-IP are honoured only when the immediate peer is in
# one of these ranges. Getting this wrong makes rate limiting bypassable.
TRUSTED_PROXY_CIDRS=

# ---- HTTP server hardening -------------------------------------------------
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=1048576
HTTP_MAX_BODY_BYTES=1048576
HTTP_HANDLER_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=20s

# ---- Account lockout -------------------------------------------------------
LOCKOUT_THRESHOLD=10
LOCKOUT_BASE_WINDOW=15m
LOCKOUT_MAX_WINDOW=24h
LOCKOUT_BACKOFF_STEP=5

# ---- Mail ------------------------------------------------------------------
MAILER_DRIVER=log                   # log | smtp | noop
MAIL_FROM=no-reply@example.com
MAIL_SEND_TIMEOUT=10s
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
